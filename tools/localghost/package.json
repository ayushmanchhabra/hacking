{
  "name": "localghost",
  "main": "http://localhost:8080",
  "node-remote": "http://localhost:8080",
  "node-main": "server.js",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix",
    "type": "tsc --noEmit",
    "doc": "node ./config/doc.js",
    "dev": "concurrently -k npm:dev:website npm:dev:css npm:dev:server npm:dev:desktop",
    "dev:website": "esbuild ./src/website/main.tsx --bundle --outdir=./src/website --watch --servedir=./src/website --serve=8080",
    "dev:css": "tailwindcss -i ./src/website/styles.css -o ./src/desktop/styles.css --watch",
    "dev:server": "esbuild ./src/server/desktop.ts --bundle --platform=node --format=cjs --outfile=./src/desktop/server.js --watch",
    "dev:desktop": "wait-on -c ./config/wait.json http-get://localhost:8080 && ./config/dev.js",
    "bld": "npm run bld:website && npm run bld:server && npm run bld:desktop",
    "bld:website": "cp ./src/website/index.html ./src/desktop/index.html && esbuild ./src/website/main.tsx --bundle --outdir=./src/desktop && tailwindcss -i ./src/website/styles.css -o ./src/desktop/styles.css --minify",
    "bld:desktop": "node ./config/bld.js",
    "bld:server": "esbuild ./src/server/desktop.ts --bundle --platform=node --format=cjs --outfile=./src/desktop/server.js",
    "pkg:desktop": "node ./config/pkg.js",
    "e2e": "node --test --experimental-test-coverage --test-coverage-exclude=\"tests/**/*\" \"tests/specs/*.test.js\"",
    "server": "node src/server/server.ts"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nwutils/doctor": "^0.1.2",
    "@nwutils/getter": "^0.3.1",
    "@nwutils/runner": "^0.2.6",
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "nw-builder": "^4.20.0",
    "prettier": "^3.9.8",
    "selenium-webdriver": "^4.49.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "wait-on": "^9.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "warn",
      "version": "26.7.0"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "warn"
    }
  }
}
